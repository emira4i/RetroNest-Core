# AIDL binder protocol shared by the app and the core host: generated Stub / Proxy classes and the constants
# (including HOST_SERVICE_CLASS) must stay intact.
-keep class com.retronest.corehost.ICoreHost { *; }
-keep class com.retronest.corehost.ICoreHost$* { *; }
-keep class com.retronest.corehost.ICoreHostCallback { *; }
-keep class com.retronest.corehost.ICoreHostCallback$* { *; }
-keep class com.retronest.corehost.CoreHostProtocol { *; }
